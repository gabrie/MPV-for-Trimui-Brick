# gptokeyb2 configuration for mpv on TrimUI Brick
# Maps gamepad buttons to standard mpv keyboard controls

# D-Pad: Seeking
# up / down: seek 60 seconds forward / backward
up = up
down = down
# left / right: seek 5 seconds backward / forward
left = left
right = right

# Action buttons
# A / B: Play / Pause (space)
a = space
b = space
# X: Zoom / Fill to Vertical Axis (短边/竖轴拉伸撑满)
x = x
# Y: Zoom / Fill to Horizontal Axis (长边/横轴拉伸撑满)
y = y

# Shoulder buttons
# L1 / R1: Speed down / speed up by 10% ([ and ] in mpv)
l1 = [
r1 = ]
# L2 / R2: Previous video / Next video (< and > in mpv)
l2 = <
r2 = >

# System buttons
# Start: Play / Pause (space)
start = space
# Select: Mute / Unmute (m in mpv)
select = m
# Back / Guide / Stick click: Quit mpv (q)
back = q
guide = q
l3 = q
r3 = q
