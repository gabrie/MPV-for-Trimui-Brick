# gptokeyb2 configuration for mpv on TrimUI Brick
# Maps gamepad buttons to standard mpv keyboard controls

# D-Pad: Seeking
# up / down: seek 60 seconds (single-shot, no repeat)
up = up
down = down
# left / right: seek 5 seconds (continuous auto-repeat when held)
left = repeat left
right = repeat right

# Action buttons
# A / B: Play / Pause (space)
a = space
b = space
# X: Zoom / Fill to Vertical Axis (x in mpv)
x = x
# Y: Zoom / Fill to Horizontal Axis (y in mpv)
y = y

# Shoulder buttons
# L1 / R1: Speed down / speed up by 10%
l1 = [
r1 = ]
# L2 / R2: Previous video / Next video
l2 = <
r2 = >

# System buttons
# Start: Play / Pause (space)
start = space
# Select: Mute / Unmute (m in mpv)
select = m
# Back / Guide / Stick click: Quit mpv (q)
back = q
guide = q
l3 = q
r3 = q
